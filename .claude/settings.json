{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.local/bin/graphify hook-guard read"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.local/bin/graphify hook-guard read --strict"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx eslint *)",
      "Bash(echo \"eslint exit: $?\")"
    ],
    "deny": [
      "Bash(git commit --amend:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf *)",
      "Bash(rm -rf /*)",
      "Bash(ssh s01 \"*dd if=*\")",
      "Bash(ssh s01 \"*mkfs*\")",
      "Bash(ssh s01 \"*docker system prune*\")",
      "Bash(ssh s01 \"*docker volume rm*\")",
      "Bash(ssh s01 \"*vim *\")",
      "Bash(ssh s01 \"*vi *\")",
      "Bash(ssh s01 \"*nano *\")",
      "Bash(ssh s01 \"*rm *\")",
      "Bash(ssh s01 \"*rm -rf*\")",
      "Bash(ssh s01 \"*sed -i*\")",
      "Bash(ssh s01 \"*chmod *\")",
      "Bash(ssh s01 \"*chown *\")",
      "Bash(ssh s01 \"sudo*\")",
      "Bash(ssh s01 \"systemctl start*\")",
      "Bash(ssh s01 \"systemctl stop*\")",
      "Bash(ssh s01 \"systemctl disable*\")"
    ]
  }
}
