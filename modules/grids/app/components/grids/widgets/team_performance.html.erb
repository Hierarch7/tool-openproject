<%= widget_wrapper do |container| %>
  <% container.with_body(classes: "op-team-performance", test_selector: "team-performance-widget") do %>
    <%= render(Primer::Alpha::SegmentedControl.new("aria-label": t(".period_label"), size: :small, mb: 3)) do |control| %>
      <% PERIODS.each do |days| %>
        <% control.with_item(
             tag: :a,
             href: period_path(days),
             label: t(".period", count: days),
             selected: days == selected_period,
             data: { turbo_frame: wrapper_key }
           ) %>
      <% end %>
    <% end %>

    <% if !configured? %>
      <%= render(Primer::Beta::Blankslate.new(test_selector: "team-performance-widget-not-configured")) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :gear) %>
        <% blankslate.with_heading(tag: :h3).with_content(t(".not_configured.heading")) %>
        <% blankslate.with_description_content(t(".not_configured.description")) %>
        <% if can_configure_statuses? %>
          <% blankslate.with_primary_action(href: admin_settings_work_packages_general_path, scheme: :secondary) do %>
            <%= t(".configure_statuses") %>
          <% end %>
        <% end %>
      <% end %>
    <% elsif rows.empty? %>
      <%= render(Primer::Beta::Blankslate.new(test_selector: "team-performance-widget-empty")) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :people) %>
        <% blankslate.with_heading(tag: :h3).with_content(t(".empty.heading")) %>
        <% blankslate.with_description_content(t(".empty.description")) %>
      <% end %>
    <% else %>
      <table class="op-team-performance--table">
        <thead>
          <tr>
            <th scope="col"><%= WorkPackage.human_attribute_name(:assigned_to) %></th>
            <% Grids::TeamPerformance::GROUPS.each do |group| %>
              <th scope="col"><%= t(".columns.#{group}") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr>
              <th scope="row">
                <% if row.principal %>
                  <%= render(Users::AvatarComponent.new(user: row.principal, size: :mini, link: false, show_name: true)) %>
                <% else %>
                  <%= render(Primer::Beta::Text.new(color: :subtle)) { t(".unassigned") } %>
                <% end %>
              </th>
              <% Grids::TeamPerformance::GROUPS.each do |group| %>
                <% ids = row.public_send(group) %>
                <td>
                  <% if ids.any? %>
                    <%= render(Primer::Beta::Link.new(href: work_packages_path(ids))) { ids.size.to_s } %>
                  <% else %>
                    <%= render(Primer::Beta::Text.new(color: :subtle)) { "0" } %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row"><%= t(:label_total) %></th>
            <% Grids::TeamPerformance::GROUPS.each do |group| %>
              <td><%= totals[group] %></td>
            <% end %>
          </tr>
        </tfoot>
      </table>

      <%= render(Primer::Beta::Text.new(tag: :p, color: :subtle, font_size: :small, mt: 3, mb: 0)) { t(".caption") } %>
    <% end %>
  <% end %>

  <% if configured? && can_configure_statuses? %>
    <% container.with_footer do %>
      <%= render(Primer::Beta::Link.new(href: admin_settings_work_packages_general_path)) { t(".configure_statuses") } %>
    <% end %>
  <% end %>
<% end %>
